# URL publique du site (liens d'email Supabase, ex. reset password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (même projet que Cockpit - base partagée, cf. AGENTS.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de données (Prisma) ---
# DATABASE_URL : connexion via le pooler Supabase (pgbouncer, port 6543) - runtime.
# DIRECT_URL   : connexion directe (port 5432) - requise par Prisma pour les migrations.
DATABASE_URL=
DIRECT_URL=

# --- Intégrations CRM (Lots 3 à 5) ---
RINGOVER_API_KEY=
RINGOVER_WEBHOOK_SECRET=
JOTFORM_API_KEY=
JOTFORM_WEBHOOK_SECRET=
JOTFORM_ESTIMATION_FORM_ID=
CRON_SECRET=
CITYSCAN_API_KEY=

# --- Apimo (écriture) : push des estimations JotForm en Lead Apimo.
# APIMO_PROVIDER (auth Basic provider:token) et APIMO_AGENCY_ID (chemin
# /agencies/{id}/...) sont deux identifiants différents, cf.
# lib/integrations/apimo/client.ts.
APIMO_API_KEY=
APIMO_PROVIDER=
APIMO_AGENCY_ID=

# --- Page Prospects : analyse IA des boîtes mail (cf. lib/prospects-mail/) ---
# Compte de service Google avec délégation au niveau du domaine (scope
# gmail.readonly) sur les boîtes analysées.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_WORKSPACE_DOMAIN=miltonimmobilier.fr
# Clé Google AI Studio (Gemini).
google_ai_studio=
# Optionnels : boîtes (défaut contact@ et prospects@ du domaine), fenêtre
# d'analyse en jours (défaut 14), modèle Gemini (défaut gemini-3.8-flash).
# PROSPECTS_MAILBOXES=contact@miltonimmobilier.fr,prospects@miltonimmobilier.fr
# PROSPECTS_MAIL_WINDOW_DAYS=14
# GEMINI_MODEL=gemini-3.8-flash
